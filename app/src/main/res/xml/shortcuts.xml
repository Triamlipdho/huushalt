<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon (F9.7). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_add"
        android:shortcutId="new_chore"
        android:shortcutLongLabel="@string/shortcut_new_long"
        android:shortcutShortLabel="@string/shortcut_new_short">
        <intent
            android:action="xyz.haselbach.huushalt.action.NEW_CHORE"
            android:targetClass="xyz.haselbach.huushalt.MainActivity"
            android:targetPackage="xyz.haselbach.huushalt" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_catalog"
        android:shortcutId="catalog"
        android:shortcutLongLabel="@string/shortcut_catalog_long"
        android:shortcutShortLabel="@string/shortcut_catalog_short">
        <intent
            android:action="xyz.haselbach.huushalt.action.CATALOG"
            android:targetClass="xyz.haselbach.huushalt.MainActivity"
            android:targetPackage="xyz.haselbach.huushalt" />
    </shortcut>
</shortcuts>
